DEMO_MODE=false
HOST=127.0.0.1
PORT=8080
CLUSTER_NAME=my-cluster
API_TOKEN_FILE=/absolute/path/to/api-token
KUBE_API_URL=https://kubernetes.default.svc
KUBE_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# For a local dashboard, enable kubeconfig discovery. KUBECONFIG accepts multiple
# files separated by the operating system path delimiter (`;` on Windows, `:` on Linux).
KUBECONFIG_ENABLED=false
# KUBECONFIG=C:\Users\you\.kube\config;C:\clusters\staging.yaml
# KUBECTL_PATH=kubectl
PROMETHEUS_URL=http://observability-prometheus.monitoring.svc.cluster.local:9090
ALLOWED_ORIGINS=
LOGS_ENABLED=false
