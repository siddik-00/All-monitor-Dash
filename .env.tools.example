# Copy selected settings into your shell; never put real tokens in Git.
# Browser token = operator API token. Upstream tokens stay on the API server.
DEMO_MODE=false
API_TOKEN_FILE=.secrets/api-token
KUBE_API_URL=https://kubernetes.default.svc
KUBE_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
PROMETHEUS_URL=http://observability-prometheus.monitoring.svc.cluster.local:9090
ARGOCD_URL=https://argocd-server.argocd.svc.cluster.local
ARGOCD_TOKEN_FILE=.secrets/argocd-token
ARGOCD_CA_FILE=.secrets/argocd-ca.crt
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local
GRAFANA_TOKEN_FILE=.secrets/grafana-token
LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
TEMPO_URL=http://tempo.monitoring.svc.cluster.local:3200
ALERTMANAGER_URL=http://observability-alertmanager.monitoring.svc.cluster.local:9093
ALLOY_URL=http://alloy.monitoring.svc.cluster.local:12345
OTEL_HEALTH_URL=http://otel-collector.monitoring.svc.cluster.local:13133
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4318/v1/traces
REQUEST_LOGS=true
